{
	"java.compile.nullAnalysis.mode": "automatic",
	"java.configuration.updateBuildConfiguration": "automatic",
	"maven.view": "flat",
	"maven.terminal.favorites": [
		{
			"alias": "clean install",
			"command": "clean install"
		},
		{
			"alias": "Test Suite - All",
			"command": "test -Dsurefire.suiteXmlFiles=src/test/test_suites/testng.xml"
		}
	],
	"java.test.defaultConfig": "TestNG",
	"java.test.config": {
		"name": "TestNG",
		"coverage": {
			"enabled": true
		},
		"workingDirectory": "${workspaceFolder}",
		"classPaths": [
			"${workspaceFolder}/src/test/resources",
			"${workspaceFolder}/src/test/test_suites"
		],
		"testKind": "testng"
	}
}